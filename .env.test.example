# Copy these values into the test command environment, not the application .env file.
# The PostgreSQL database name must end in _test or cleanup fails closed.
TICKETING_TEST_DATABASE_URL=postgresql+asyncpg://ticketing:ticketing@127.0.0.1:5432/ticketing_test

# Redis DB 0 is used by the app and DB 1 by Celery; tests use isolated DBs.
TICKETING_TEST_REDIS_URL=redis://127.0.0.1:6379/15
TICKETING_TEST_CELERY_BROKER_URL=redis://127.0.0.1:6379/14
