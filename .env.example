TICKETING_APP_NAME=FastAPI Ticketing System
TICKETING_ENVIRONMENT=local
TICKETING_LOG_LEVEL=INFO
TICKETING_API_V1_PREFIX=/api/v1
TICKETING_DATABASE_URL=postgresql+asyncpg://ticketing:ticketing@127.0.0.1:5432/ticketing
TICKETING_DATABASE_POOL_SIZE=5
TICKETING_DATABASE_MAX_OVERFLOW=10
TICKETING_DATABASE_POOL_TIMEOUT_SECONDS=30
TICKETING_AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
TICKETING_ACCESS_TOKEN_TTL_MINUTES=15
TICKETING_REFRESH_TOKEN_TTL_DAYS=7
TICKETING_ATTACHMENT_STORAGE_PATH=var/attachments
TICKETING_ATTACHMENT_MAX_SIZE_BYTES=5242880
TICKETING_REDIS_URL=redis://127.0.0.1:6379/0
TICKETING_REDIS_TIMEOUT_SECONDS=0.5
TICKETING_PERMISSION_CACHE_TTL_SECONDS=300
TICKETING_PERMISSION_CACHE_TTL_JITTER_SECONDS=30
TICKETING_LOGIN_RATE_LIMIT_REQUESTS=5
TICKETING_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
TICKETING_CELERY_BROKER_URL=redis://127.0.0.1:6379/1
TICKETING_BACKGROUND_JOB_MAX_ATTEMPTS=5
TICKETING_BACKGROUND_JOB_LEASE_SECONDS=120
TICKETING_BACKGROUND_JOB_SOFT_TIME_LIMIT_SECONDS=60
TICKETING_BACKGROUND_JOB_HARD_TIME_LIMIT_SECONDS=75
TICKETING_BACKGROUND_JOB_RETRY_BASE_SECONDS=2
TICKETING_BACKGROUND_JOB_RETRY_MAX_SECONDS=300
TICKETING_OUTBOX_BATCH_SIZE=100
TICKETING_OUTBOX_POLL_SECONDS=2
TICKETING_EXPORT_STORAGE_PATH=var/exports
TICKETING_EXPORT_MAX_ROWS=10000
# console only logs a simulation; set smtp plus host details for real delivery.
TICKETING_EMAIL_BACKEND=console
TICKETING_EMAIL_FROM=support@example.com
TICKETING_SMTP_HOST=
TICKETING_SMTP_PORT=587
TICKETING_SMTP_USERNAME=
TICKETING_SMTP_PASSWORD=
TICKETING_SMTP_STARTTLS=true
