# Copy to .env.production and replace every placeholder before production startup.
POSTGRES_DB=ticketing
POSTGRES_USER=ticketing
POSTGRES_PASSWORD=replace-with-a-strong-database-password

TICKETING_AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
TICKETING_DATABASE_URL=postgresql+asyncpg://ticketing:replace-with-a-url-encoded-database-password@postgres:5432/ticketing
TICKETING_REDIS_URL=redis://redis:6379/0
TICKETING_CELERY_BROKER_URL=redis://redis:6379/1
TICKETING_LOG_LEVEL=INFO

TICKETING_HTTP_PORT=8080
TICKETING_WEB_WORKERS=4
TICKETING_CELERY_CONCURRENCY=4
TICKETING_FORWARDED_ALLOW_IPS=127.0.0.1
